{
  "name": "vuongthm-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "pipeline": "node scripts/pipeline.mjs --mode=build",
        "dev": "node scripts/pipeline.mjs --mode=dev && next dev",
    "dev:network": "node scripts/pipeline.mjs --mode=dev && next dev --hostname 0.0.0.0",
    "dev:lan": "node scripts/pipeline.mjs --mode=dev && next dev --hostname 192.168.1.17",
    "dev:stop": "node scripts/dev-stop.mjs",
    "build": "node scripts/pipeline.mjs --mode=build && next build && node scripts/prune-originals.mjs",
    "build:force": "node scripts/pipeline.mjs --mode=build --force && next build && node scripts/prune-originals.mjs",
    "images": "node scripts/optimize-images.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build:optimized": "OPTIMIZE_IMAGES=1 node scripts/pipeline.mjs --mode=build && next build && node scripts/prune-originals.mjs",
    "dev:light": "node scripts/pipeline.mjs --mode=dev && taskset -c 0-2 next dev",
    "build:light": "node scripts/pipeline.mjs --mode=build && taskset -c 0-2 next build && node scripts/prune-originals.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "fuse.js": "^7.4.2",
    "leva": "^0.10.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postcss": "^8.5",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.2.0",
    "typescript": "5.7.3",
    "vitest": "^3",
    "yaml": "^2.6.0"
  }
}
